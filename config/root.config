# Project overrides for the Samsung kernel configuration

CONFIG_LOCALVERSION="-DZG1-nawaf-resukisu"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set

# ReSukiSU uses inline SuSFS hooks without tracepoints or kprobes.
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set

CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y

CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# These Samsung protections interfere with kernel root support.
# CONFIG_UH is not set
# CONFIG_RKP is not set
# CONFIG_KDP is not set
# CONFIG_KDP_CRED is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_FIVE is not set
# CONFIG_PROCA is not set

# Keep exported symbols available to vendor modules.
# CONFIG_MODULE_SIG_PROTECT is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
